# Server Port (Default 4000)
PORT=4000

# Neo4j AuraDB Connection Details
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_secure_password_here

# Groq LLM API Key (Get yours at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model (Defaults to llama-3.1-8b-instant. Other options: llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it)
GROQ_MODEL=llama-3.1-8b-instant
